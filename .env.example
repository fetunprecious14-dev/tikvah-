# Copy to .env and fill in for local development.
# See replit.md > "Run & Operate" for what each of these does.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/tikvah
COOKIE_SECRET=

# --- Required locally, provided by the host in a deployment ---
# Both servers read PORT; Vercel does not use it.
PORT=5000

# --- Optional ---
# Base URL used in email links. Defaults to the Vercel deployment's own URL on
# Vercel, and to http://localhost:5173 otherwise — only set it for a custom
# domain or a non-Vercel host.
APP_URL=
DATABASE_POOL_MAX=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=
RESEND_API_KEY=
EMAIL_FROM="Tikvah <onboarding@resend.dev>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
REDIS_URL=

# Frontend dev server only — set to the API server's PORT to enable the /api proxy.
API_PORT=
