# Copy to .env and fill in for local development.
# See replit.md > "Run & Operate" for what each of these does, and
# replit.md > "Deploying to Vercel" for which of these to set in Vercel.

# --- Required ---

# Postgres connection string. The backing database is the Supabase project
# `fetunprecious14-dev's Project` (ref: fybptbghwmochcptgnrl, eu-central-1).
#
# Get the exact string from the Supabase dashboard: Connect (top of the project
# page) → choose the mode below → copy → replace [YOUR-PASSWORD] with the
# database password. Which mode you want depends on where it runs:
#
#   * On Vercel — use the SHARED POOLER, TRANSACTION MODE (port 6543):
#       postgresql://postgres.fybptbghwmochcptgnrl:[YOUR-PASSWORD]@aws-[N]-eu-central-1.pooler.supabase.com:6543/postgres
#     Vercel's runtime is IPv4-only and Supabase's direct connection is IPv6, so
#     the direct string below CANNOT reach the database from Vercel. The pooler
#     is IPv4 on every plan, and transaction mode is the right one for
#     serverless functions that open many short-lived connections.
#
#   * Locally / any long-running server — the direct connection is fine if your
#     network has IPv6, otherwise use the pooler in session mode (port 5432):
#       postgresql://postgres:[YOUR-PASSWORD]@db.fybptbghwmochcptgnrl.supabase.co:5432/postgres
#
# Note the pooler username is `postgres.<project-ref>`, not plain `postgres`,
# and the `aws-[N]-` host prefix differs per project — copy it, don't guess it.
DATABASE_URL=

# --- Required: Supabase Auth ---
# Signup, login, logout, email confirmation, and password reset are all
# handled by Supabase Auth now, on both the frontend (via @supabase/supabase-js)
# and the API server (to verify the bearer token the frontend sends). Same
# project as DATABASE_URL above.
#
# SUPABASE_URL / VITE_SUPABASE_URL — identical value, just needed under both
# names because the frontend (Vite) only exposes env vars prefixed `VITE_` to
# browser code, and the API server reads the unprefixed name.
SUPABASE_URL=https://fybptbghwmochcptgnrl.supabase.co
VITE_SUPABASE_URL=https://fybptbghwmochcptgnrl.supabase.co
#
# SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_PUBLISHABLE_KEY — same reasoning,
# same value. This is the publishable/anon key: it is DESIGNED to be public
# and ships in the browser bundle, same as it does in any Supabase app — it is
# not a secret and is safe to commit here. (SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
# also work as fallback names, for the legacy anon-key format.)
#
# Never put the service_role/secret key in any VITE_-prefixed variable, or
# anywhere else this app sends to the browser — it bypasses Row Level Security
# entirely. Nothing in this app currently needs it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_8jkOuPQjn5A4xY9ENbxzeQ_K8VW0PoA
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8jkOuPQjn5A4xY9ENbxzeQ_K8VW0PoA

# --- Required locally, provided by the host in a deployment ---
# Both servers read PORT; Vercel does not use it.
PORT=5000

# --- Optional ---
# Base URL used to build links inside product emails (reply notifications,
# urgent alerts — NOT signup/reset emails, which Supabase Auth sends and
# builds its own links for, using its Redirect URLs allowlist instead; see
# replit.md). Defaults to the Vercel deployment's own URL on Vercel, and to
# http://localhost:5173 otherwise — only set it for a custom domain or a
# non-Vercel host.
APP_URL=

# Caps the pg connection pool per process. Defaults to 1 on Vercel/Lambda and 10
# elsewhere; the default is already the right answer for the Supabase pooler.
DATABASE_POOL_MAX=

ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=
# Optional one-time bootstrap. The account matching this email becomes an
# admin as soon as its Tikvah profile exists AND Supabase Auth has confirmed
# the address — same "prove ownership first" guarantee as before, just
# checked against Supabase's own email_confirmed_at now. Keep this server-side.
INITIAL_ADMIN_EMAIL=
# Only used for reply-notification and urgent-alert emails now — Supabase Auth
# sends signup confirmation and password-reset emails itself (its default
# sender is fine for development; see replit.md for wiring custom SMTP later).
RESEND_API_KEY=
EMAIL_FROM="Tikvah <onboarding@resend.dev>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
REDIS_URL=

# API server only. Pins CORS to one origin; defaults to reflecting the request
# origin, which is fine while the frontend and API share a Vercel deployment.
CORS_ORIGIN=
# API server only. pino level: trace|debug|info|warn|error|fatal. Defaults to info.
LOG_LEVEL=

# Frontend dev server only — set to the API server's PORT to enable the /api proxy.
API_PORT=
# Frontend build only. Sub-path the app is served from; defaults to / (correct
# for Vercel, which serves it from the domain root).
BASE_PATH=
